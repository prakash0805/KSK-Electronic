# Copy this file to .env and fill in your own values

# Local MongoDB:      mongodb://127.0.0.1:27017/ksk_electronics
# MongoDB Atlas:       mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ksk_electronics
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ksk_electronics?retryWrites=true&w=majority

# Port the Express server runs on
PORT=5000

# Simple key that protects the admin endpoints (list/update/delete enquiries)
# Send it as header:  x-admin-key: <this value>
ADMIN_KEY=siva123

# Owner's WhatsApp/mobile number in international format, no + or spaces
OWNER_MOBILE=919944975893
